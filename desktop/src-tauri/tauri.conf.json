{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TAC FC",
  "version": "1.0.0",
  "identifier": "com.tacfc.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "publisher": "TAC FC",
    "homepage": "https://tacfc.com",
    "copyright": "TAC FC",
    "category": "SportsGame",
    "shortDescription": "TAC FC, the free online football manager",
    "longDescription": "TAC FC, the free online football manager. This app opens tacfc.com in its own window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "TAC FC",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "Arabic", "German", "French", "Spanish", "Turkish"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0RDhGNTc3MTVBN0MwODYKUldTR3dLY1ZkL1hZSlBGamRRSjNXZWNFQm5RMnU1YWg1bmRScUtGcjVFbE1wc011WElwYUZkWFoK",
      "endpoints": [
        "https://tacfc.com/downloads/desktop/latest.json",
        "https://github.com/mutazzuhairi/tmx/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
